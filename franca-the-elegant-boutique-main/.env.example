# Copiá este archivo a .env y completá los valores (el .env NO se sube a git).
#
# Producción (Cloudflare Workers Builds, worker "franca"):
#  - Las VITE_* públicas salen de .env.production (está en el repo).
#    OJO: las variables de build del panel de Cloudflare PISAN a .env.production.
#  - La clave secreta es el secreto del Worker SUPABASE_SERVICE_ROLE_KEY (no va en ningún archivo).

# Públicas (también se cargan como variables de build en Cloudflare)
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""

# SECRETA: solo servidor. En Cloudflare se carga con:
#   npx wrangler secret put SUPABASE_SERVICE_ROLE_KEY --name franca
SUPABASE_SERVICE_ROLE_KEY=""
